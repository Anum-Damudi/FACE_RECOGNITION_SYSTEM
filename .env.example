# Copy to .env and adjust (optional; defaults work for local dev without .env)

FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Gallery and logs (absolute or relative paths)
CRIMINALS_DIR=./criminals
LOGS_DIR=./logs

# DeepFace
DEEPFACE_MODEL=Facenet512
DISTANCE_METRIC=cosine
# Match when cosine distance is STRICTLY BELOW this value (lower = stricter)
MATCH_THRESHOLD=0.6

# MongoDB
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=surveillance_alerts
DETECTION_LOGS_COLLECTION=detection_logs

# Alerts (Windows: MessageBox + winsound beep)
ENABLE_POPUP=true
ENABLE_SOUND_ALARM=true
